---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { perfumesDeMuestra } from "../../data/perfumes";
import { sanityClient, PERFUMES_QUERY } from "../../lib/sanity";
import { linkWhatsapp, siteConfig } from "../../config";
import type { Perfume } from "../../types";

export async function getStaticPaths() {
  const perfumes: Perfume[] = sanityClient
    ? await sanityClient.fetch(PERFUMES_QUERY)
    : perfumesDeMuestra;

  return perfumes.map((perfume) => ({
    params: { slug: perfume.slug },
    props: { perfume },
  }));
}

const { perfume } = Astro.props as { perfume: Perfume };
---

<Layout title={`${perfume.nombre} — ${siteConfig.nombre}`} description={perfume.descripcion}>
  <Header />

  <main class="mx-auto max-w-4xl px-6 pb-24">
    <a href="/" class="inline-block py-6 text-sm text-bone/50 hover:text-bone">
      ← Volver al catálogo
    </a>

    <div class="grid gap-10 sm:grid-cols-2">
      <div class="overflow-hidden rounded-lg border border-white/10 bg-surface">
        <img
          src={perfume.imagen}
          alt={`Frasco de ${perfume.nombre}`}
          class="aspect-[4/5] w-full object-cover"
        />
      </div>

      <div class="flex flex-col gap-4 py-2">
        <p class="text-xs uppercase tracking-wide text-bone/50">{perfume.marca}</p>
        <h1 class="font-display text-3xl text-bone sm:text-4xl">{perfume.nombre}</h1>

        <div class="flex flex-wrap gap-1.5">
          {
            perfume.categorias.map((categoria) => (
              <span class="rounded-full border border-white/10 px-2.5 py-0.5 text-xs text-bone/60">
                {categoria}
              </span>
            ))
          }
        </div>

        <p class="text-base leading-relaxed text-bone/80">{perfume.descripcion}</p>

        {
          !perfume.disponible && (
            <p class="text-sm text-wine">Actualmente sin stock</p>
          )
        }

        <a
          href={linkWhatsapp(perfume.nombre)}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex w-fit items-center justify-center rounded-full bg-amber px-6 py-3 text-sm font-medium text-ink transition-colors hover:bg-amber-light"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </main>
</Layout>

---
import type { Perfume } from "../types";
import { formatCLP } from "../config";

interface Props {
  perfumes: Perfume[];
}

const { perfumes } = Astro.props;
---

{
  perfumes.length > 0 && (
    <section class="mt-16 border-t border-black/10 pt-10">
      <h2 class="mb-6 font-display text-2xl uppercase tracking-wide text-ink">
        También te puede interesar
      </h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {perfumes.map((perfume) => (
          <a
            href={`/perfume/${perfume.slug}`}
            class="group flex h-full flex-col overflow-hidden rounded-lg border border-black/10 bg-surface transition-colors hover:border-amber/50"
          >
            <div class="aspect-[4/5] overflow-hidden bg-surface-light">
              <img
                src={perfume.imagen}
                alt={`Frasco de ${perfume.nombre}`}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-1 flex-col gap-1 p-4">
              <p class="text-xs uppercase tracking-wide text-ink/50">{perfume.marca}</p>
              <h3 class="font-body text-base font-semibold leading-tight text-ink">{perfume.nombre}</h3>
              <span class="w-fit rounded border border-ink/20 px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-ink">
                {perfume.volumenMl} ML
              </span>
              <p class="mt-auto pt-2 text-sm font-semibold text-ink">{formatCLP(perfume.precio)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

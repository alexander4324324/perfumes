---
const categorias = ["Todos", "Hombre", "Mujer", "Unisex", "Noche"] as const;
---

<div
  class="sticky top-0 z-10 -mx-6 border-b border-black/10 bg-canvas/90 px-6 py-4 backdrop-blur"
  id="filtros"
>
  <div class="mx-auto flex max-w-5xl flex-wrap gap-2">
    {
      categorias.map((categoria, i) => (
        <button
          type="button"
          data-filtro={categoria}
          aria-pressed={i === 0 ? "true" : "false"}
          class:list={[
            "filtro-btn rounded-full border px-4 py-1.5 text-sm transition-colors",
            i === 0
              ? "border-amber bg-amber text-white"
              : "border-black/15 text-ink/70 hover:border-amber/60 hover:text-ink",
          ]}
        >
          {categoria}
        </button>
      ))
    }
  </div>
</div>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>(".filtro-btn");
  const tarjetas = document.querySelectorAll<HTMLElement>("[data-categorias]");

  botones.forEach((boton) => {
    boton.addEventListener("click", () => {
      const filtro = boton.dataset.filtro!;

      botones.forEach((b) => {
        const activo = b === boton;
        b.setAttribute("aria-pressed", String(activo));
        b.classList.toggle("bg-amber", activo);
        b.classList.toggle("text-white", activo);
        b.classList.toggle("border-amber", activo);
        b.classList.toggle("border-black/15", !activo);
        b.classList.toggle("text-ink/70", !activo);
      });

      tarjetas.forEach((tarjeta) => {
        const categorias = tarjeta.dataset.categorias?.split(",") ?? [];
        const coincide = filtro === "Todos" || categorias.includes(filtro);
        tarjeta.classList.toggle("hidden", !coincide);
      });
    });
  });
</script>

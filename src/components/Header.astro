---
import { siteConfig } from "../config";
---

<header class="relative overflow-hidden border-b border-black/10">
  <div
    class="pointer-events-none absolute -top-24 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-amber/10 blur-3xl"
  >
  </div>
  <div class="relative mx-auto max-w-5xl px-6 py-20 text-center sm:py-28">
    <a href="/" class="inline-flex flex-col leading-[0.9]">
      <span
        class="font-display text-5xl uppercase tracking-wide bg-clip-text text-transparent sm:text-6xl md:text-7xl"
        style="background: linear-gradient(180deg, #6b6b6b 0%, #1a1a1a 25%, #000000 50%, #4a4a4a 70%, #0a0a0a 100%); -webkit-background-clip: text; text-shadow: 0 1px 1px rgba(255,255,255,0.15);"
      >
        {siteConfig.nombreLinea1}
      </span>
      <span
        class="font-display text-2xl uppercase tracking-[0.2em] bg-clip-text text-transparent sm:text-3xl md:text-4xl"
        style="background: linear-gradient(180deg, #6b6b6b 0%, #1a1a1a 25%, #000000 50%, #4a4a4a 70%, #0a0a0a 100%); -webkit-background-clip: text; text-shadow: 0 1px 1px rgba(255,255,255,0.15);"
      >
        {siteConfig.nombreMedio}
      </span>
      <span
        class="font-display text-6xl uppercase tracking-wide bg-clip-text text-transparent sm:text-7xl md:text-8xl"
        style="background: linear-gradient(180deg, #FFF6D8 0%, #F3DA8E 20%, #D9AE3F 45%, #B8892E 65%, #E8C976 80%, #8A661F 100%); -webkit-background-clip: text; text-shadow: 0 1px 1px rgba(0,0,0,0.15);"
      >
        {siteConfig.nombreLinea2}
      </span>
    </a>
    <p class="mx-auto mt-6 max-w-lg text-balance font-tagline text-xl font-semibold italic text-ink/80 sm:text-2xl">
      {siteConfig.tagline}
    </p>
  </div>
</header>

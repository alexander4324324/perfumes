---
import type { Perfume } from "../types";
import { formatCLP } from "../config";

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
---

<article
  data-categorias={perfume.categorias.join(",")}
  class="group flex flex-col overflow-hidden rounded-lg border border-black/10 bg-surface transition-colors hover:border-amber/50"
>
  <a href={`/perfume/${perfume.slug}`} class="block">
    <div class="relative aspect-[4/5] overflow-hidden bg-surface-light">
      <img
        src={perfume.imagen}
        alt={`Frasco de ${perfume.nombre}`}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
      {
        !perfume.disponible && (
          <span class="absolute left-3 top-3 rounded-full bg-black/70 px-3 py-1 text-xs text-white">
            Agotado
          </span>
        )
      }
    </div>
  </a>

  <div class="flex flex-1 flex-col gap-2 p-5">
    <p class="text-xs uppercase tracking-wide text-ink/50">{perfume.marca}</p>
    <a href={`/perfume/${perfume.slug}`}>
      <h3 class="font-display text-xl text-ink">{perfume.nombre}</h3>
    </a>
    <p class="line-clamp-2 text-sm text-ink/70">{perfume.descripcion}</p>

    <div class="mt-1 flex flex-wrap gap-1.5">
      {
        perfume.categorias.map((categoria) => (
          <span class="rounded-full border border-black/10 px-2.5 py-0.5 text-xs text-ink/60">
            {categoria}
          </span>
        ))
      }
    </div>

    <p class="mt-2 font-display text-lg text-amber">{formatCLP(perfume.precio)}</p>

    <button
      type="button"
      data-agregar-carrito
      data-id={perfume._id}
      data-nombre={perfume.nombre}
      data-marca={perfume.marca}
      data-precio={perfume.precio}
      class="mt-3 inline-flex items-center justify-center rounded-full bg-amber px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-amber-light"
    >
      Agregar
    </button>
  </div>
</article>

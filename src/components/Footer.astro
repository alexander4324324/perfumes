---
import { siteConfig, instagramUrl } from "../config";
---

<footer class="bg-[#0a0a0a] py-14">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 text-center">
    <a href="/" class="inline-flex flex-col items-center leading-[0.9]">
      <span class="font-display text-2xl uppercase tracking-wide text-white">
        {siteConfig.nombreLinea1}
      </span>
      <span
        class="font-display text-4xl uppercase tracking-wide bg-clip-text text-transparent"
        style="background: linear-gradient(180deg, #FFF6D8 0%, #F3DA8E 20%, #D9AE3F 45%, #B8892E 65%, #E8C976 80%, #8A661F 100%); -webkit-background-clip: text;"
      >
        {siteConfig.nombreLinea2}
      </span>
    </a>

    <p class="max-w-sm text-lg font-semibold text-white">
      {siteConfig.tagline}
    </p>

    <ul class="flex flex-col gap-1.5">
      {
        siteConfig.infoEntrega.map((linea) => (
          <li class="flex items-center justify-center gap-2 text-sm text-white/60">
            <span aria-hidden="true">{linea.emoji}</span>
            <span>{linea.texto}</span>
          </li>
        ))
      }
    </ul>

    <a
      href={instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Síguenos en Instagram"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[#0a0a0a] transition-transform hover:scale-105"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
    </a>

    <p class="text-xs text-white/40">
      © {new Date().getFullYear()} {siteConfig.nombre}
    </p>
  </div>
</footer>

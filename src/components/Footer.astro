---
import { siteConfig, instagramUrl } from "../config";

const iconos: Record<string, string> = {
  encargo: `<path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>`,
  entrega: `<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><circle cx="8" cy="18" r="1"/><circle cx="16" cy="18" r="1"/>`,
  envio: `<path d="M3 17h13V7H3v10z"/><path d="M16 10h3l3 3v4h-6v-7z"/><circle cx="7" cy="19" r="1.5"/><circle cx="18" cy="19" r="1.5"/>`,
};
---

<footer class="bg-[#0a0a0a] py-14">
  <div class="mx-auto flex max-w-md flex-col items-center gap-8 px-6 text-center">
    <a href="/" class="block h-32 w-32 overflow-hidden rounded-full ring-1 ring-white/10">
      <img
        src="/logo.jpeg"
        alt={siteConfig.nombre}
        class="h-full w-full object-cover"
      />
    </a>

    <p class="font-tagline text-xl font-semibold italic leading-relaxed text-white/85">
      {siteConfig.tagline}
    </p>

    <div class="w-full border-t border-white/10"></div>

    <ul class="flex w-full flex-col gap-3.5 text-left">
      {
        siteConfig.infoEntrega.map((linea) => (
          <li class="flex items-start gap-3 text-sm text-white/70">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 h-5 w-5 shrink-0 text-amber-light"
              set:html={iconos[linea.icono]}
            />
            <span>{linea.texto}</span>
          </li>
        ))
      }
    </ul>

    <div class="w-full border-t border-white/10"></div>

    <a
      href={instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Síguenos en Instagram"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[#0a0a0a] transition-transform hover:scale-105"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
    </a>

    <p class="text-xs text-white/40">
      © {new Date().getFullYear()} {siteConfig.nombre}
    </p>
  </div>
</footer>
